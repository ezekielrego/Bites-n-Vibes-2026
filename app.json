{
  "expo": {
    "name": "bites n vibes",
    "slug": "bitesapp26",
    "scheme": "bitesnvibes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./logo.png",
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D13"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "zw.co.bitesnvibes.app"
    },
    "android": {
      "package": "zw.co.bitesnvibes.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#0A0D13"
      }
    },
    "web": {
      "favicon": "./logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#F2221C"
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Bites & Vibes to access your photos so ticket images can be saved.",
          "savePhotosPermission": "Allow Bites & Vibes to save ticket images to your phone."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "e5fafdfc-4ed9-4a17-ad47-0b7763a1cba3"
      }
    },
    "owner": "realego"
  }
}
