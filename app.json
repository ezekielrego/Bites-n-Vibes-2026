{
  "expo": {
    "name": "Bites & Vibes",
    "slug": "bitesapp26",
    "scheme": "bitesnvibes",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./logo.png",
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D13"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "zw.co.bitesnvibes.app"
    },
    "android": {
      "package": "zw.co.bitesnvibes.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#0A0D13"
      }
    },
    "web": {
      "favicon": "./logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#FF6B3D"
        }
      ]
    ]
  }
}
